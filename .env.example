# Zesti Kitchen (Demo) - Environment Variables Example
# Duplicate this file to .env or configure in Cloudflare Pages dashboard

# Public WhatsApp contact number in E.164 without '+' (Nigerian format: 234 + 10 digits)
PUBLIC_WHATSAPP_NUMBER=2348000000000

# Optional Supabase integration (falls back seamlessly to localStorage / demo mode if omitted)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret

# Optional Paystack test/live keys (falls back to simulated test-mode authorization if omitted)
PUBLIC_PAYSTACK_KEY=pk_test_demo_placeholder_key
PAYSTACK_SECRET_KEY=sk_test_demo_placeholder_secret_key
