---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="404 – Page Not Found | Zesti Kitchen (Demo)"
  description="Sorry, the page or dish you were looking for could not be found."
>
  <div class="py-24 sm:py-36 text-center max-w-xl mx-auto px-4">
    <div class="w-20 h-20 rounded-full bg-lemon text-charcoal flex items-center justify-center font-display font-extrabold text-3xl mx-auto mb-6 shadow-xl">
      404
    </div>

    <h1 class="font-display text-4xl sm:text-5xl font-bold text-charcoal dark:text-cream text-balance">
      Dish or Page Not Found
    </h1>

    <p class="text-muted dark:text-cream/70 text-sm sm:text-base mt-3 leading-relaxed">
      Looks like this recipe isn't on our current menu. You can return to our home page or explore our full selection of Nigerian grills and small plates.
    </p>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href="/"
        class="w-full sm:w-auto px-6 py-3.5 rounded-full bg-charcoal text-lemon hover:bg-black font-bold text-xs uppercase tracking-wider transition-all shadow"
      >
        ← Back to Home
      </a>
      <a
        href="/menu"
        class="w-full sm:w-auto px-6 py-3.5 rounded-full bg-lemon text-charcoal hover:bg-yellow-300 font-bold text-xs uppercase tracking-wider transition-all shadow"
      >
        Explore Menu
      </a>
    </div>
  </div>
</Layout>
